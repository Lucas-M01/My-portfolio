{
  "name": "my-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npm run preview",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "preview": "node scripts/serve-export.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "images:optimize-profile": "node scripts/optimize-profile.mjs",
    "test": "playwright test",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.0.3",
    "@radix-ui/react-scroll-area": "^1.0.3",
    "@radix-ui/react-tooltip": "^1.0.5",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^12.38.0",
    "keen-slider": "^6.8.5",
    "next": "^15.5.29",
    "phosphor-react": "^1.4.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "5.4.0",
    "react-parallax-tilt": "^1.7.123"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.14",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.29",
    "postcss": "^8.5.23",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "browserslist": {
    "production": [
      "chrome >= 80",
      "firefox >= 80",
      "safari >= 14",
      "edge >= 80"
    ]
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
